{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "subagent_depth": 1,
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--cdp-endpoint=chrome",
        "--output-max-size=10485760",
      ],
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--autoConnect",
        "--no-usage-statistics",
        "--no-performance-crux",
      ],
    },
  },
  "agent": {
    "build": {
      "permission": {
        "skill": "allow",
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
        "memory_*": "deny",
        "ingest_*": "deny",
        "task": {
          "archivist": "deny",
          "coder": "deny",
          "inspector": "deny",
          "researcher": "deny",
          "reviewer": "deny",
          "verifier": "deny",
        },
      },
      "prompt": "Before every user-facing response, unless the user explicitly opts out, invoke and apply the `unslop` skill. If the skill cannot be loaded, report that in the response.",
    },
    "plan": {
      "permission": {
        "skill": "allow",
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
        "memory_*": "deny",
        "ingest_*": "deny",
        "task": {
          "archivist": "deny",
          "coder": "deny",
          "inspector": "deny",
          "researcher": "deny",
          "reviewer": "deny",
          "verifier": "deny",
        },
      },
      "prompt": "Before every user-facing response, unless the user explicitly opts out, invoke and apply the `unslop` skill. If the skill cannot be loaded, report that in the response.",
    },
    "general": {
      "permission": {
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
      },
    },
    "explore": {
      "permission": {
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
      },
    },
    "compaction": {
      "permission": {
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
      },
    },
    "title": {
      "permission": {
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
      },
    },
    "summary": {
      "permission": {
        "playwright_*": "deny",
        "chrome-devtools_*": "deny",
      },
    },
  },
}
